<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ketika Syam Bangkit — Pintu Menuju Baitul Maqdis</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:       #16120c;
    --parch:     #f8f3e8;
    --parch2:    #ede5cc;
    --parch3:    #e0d5b8;
    --gold:      #a67c2a;
    --gold-lt:   #c9993c;
    --gold-pale: #e8d090;
    --green:     #1b3828;
    --teal:      #1e3d3a;
    --crimson:   #6a1a1a;
    --slate:     #242c38;
    --muted:     #78684e;
    --dark:      #0c0a06;
    --dark2:     #181410;
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--dark); font-family: 'Libre Baskerville', Georgia, serif; color: var(--ink); overflow-x: hidden; }

  /* ===== PROLOG ===== */
  .prolog {
    background: var(--dark);
    padding: 64px 28px 0;
    display: flex; flex-direction: column;
    align-items: center; text-align: center;
  }
  .prolog-arabic {
    font-family: 'Amiri', serif;
    font-size: clamp(1.4rem, 3.8vw, 2.3rem);
    color: var(--gold-pale); direction: rtl;
    line-height: 2; margin-bottom: 14px;
    max-width: 680px;
  }
  .prolog-tr {
    font-style: italic; font-size: clamp(0.82rem, 1.8vw, 0.96rem);
    color: #7a6240; line-height: 1.8; margin-bottom: 8px;
    max-width: 560px;
  }
  .prolog-src { font-size: 0.67rem; color: #3e3020; }

  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 80px 28px 72px;
    position: relative; overflow: hidden;
    background: radial-gradient(ellipse 80% 60% at 50% 35%, rgba(166,124,42,0.1) 0%, transparent 65%),
                linear-gradient(170deg, #0c0a06 0%, #1a1508 55%, #080d08 100%);
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(60deg, rgba(166,124,42,0.018) 0px, rgba(166,124,42,0.018) 1px, transparent 1px, transparent 50px),
      repeating-linear-gradient(-60deg, rgba(166,124,42,0.018) 0px, rgba(166,124,42,0.018) 1px, transparent 1px, transparent 50px);
    pointer-events: none;
  }
  .hero-inner { position: relative; z-index: 1; max-width: 720px; }
  .hero-khatam {
    font-family: 'Cinzel', serif;
    font-size: 0.68rem; letter-spacing: 0.4em;
    color: var(--gold); text-transform: uppercase;
    margin-bottom: 36px; opacity: 0.75;
    animation: dawn 1.5s ease both;
  }
  .hero-arabic {
    font-family: 'Amiri', serif;
    font-size: clamp(1.6rem, 4.5vw, 2.8rem);
    color: var(--gold-pale); direction: rtl;
    line-height: 1.85; margin-bottom: 16px;
    animation: dawn 1.5s 0.25s ease both;
  }
  .hero-tr {
    font-style: italic; font-size: clamp(0.85rem, 2vw, 1rem);
    color: #9c7e48; line-height: 1.75; margin-bottom: 6px;
    animation: dawn 1.5s 0.4s ease both;
  }
  .hero-src { font-size: 0.7rem; color: #524030; margin-bottom: 56px; animation: dawn 1.5s 0.5s ease both; }
  .hero-rule {
    display: flex; align-items: center; gap: 18px;
    justify-content: center; margin-bottom: 44px;
    animation: dawn 1.5s 0.65s ease both;
  }
  .hero-rule::before, .hero-rule::after { content: ''; flex: 1; max-width: 80px; height: 1px; background: var(--gold); opacity: 0.4; }
  .hero-rule span { color: var(--gold); font-size: 0.9rem; opacity: 0.5; letter-spacing: 0.4em; }
  .hero-title {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(1.5rem, 5vw, 3.2rem);
    color: var(--parch); line-height: 1.2;
    margin-bottom: 20px; font-weight: 700;
    animation: dawn 1.5s 0.75s ease both;
  }
  .hero-title em { font-style: italic; color: var(--gold-lt); }
  .hero-sub {
    font-family: 'Libre Baskerville', serif;
    font-style: italic; font-size: clamp(0.88rem, 2vw, 1.1rem);
    color: var(--gold); letter-spacing: 0.03em;
    animation: dawn 1.5s 0.9s ease both;
  }
  .hero-meta {
    margin-top: 28px;
    font-family: 'Cinzel', serif;
    font-size: 0.62rem; letter-spacing: 0.3em;
    color: #4a3c28; text-transform: uppercase;
    animation: dawn 1.5s 1.05s ease both;
  }

  /* ===== PAGE ===== */
  .page {
    background: var(--parch);
    max-width: 840px; margin: 0 auto;
    padding: clamp(48px, 9vw, 92px) clamp(28px, 9vw, 90px);
    position: relative;
  }
  .page::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
    background: linear-gradient(90deg, var(--green) 0%, var(--green) 30%, var(--gold) 50%, var(--crimson) 70%, var(--crimson) 100%);
  }

  /* ===== TYPOGRAPHY ===== */
  p {
    font-size: clamp(1rem, 2.3vw, 1.11rem);
    line-height: 2.05; color: var(--ink);
    margin-bottom: 1.5em; text-align: justify; hyphens: auto;
  }
  .drop-cap::first-letter {
    font-family: 'Cinzel Decorative', serif;
    font-size: 5.5rem; font-weight: 700;
    float: left; line-height: 0.72;
    margin: 8px 10px 0 0; color: var(--green);
  }
  strong { font-weight: 700; color: var(--crimson); }
  em { font-style: italic; }

  /* ===== DIVIDER ===== */
  .divider { display: flex; align-items: center; gap: 14px; margin: 58px 0 30px; }
  .divider::before { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--gold)); }
  .divider::after  { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold), transparent); }
  .div-txt { font-family: 'Cinzel', serif; font-size: 0.72rem; letter-spacing: 0.18em; color: var(--gold); white-space: nowrap; text-transform: uppercase; }

  /* ===== PULL QUOTE ===== */
  .pull {
    border-left: 4px solid var(--gold);
    padding: 22px 30px 22px 34px; margin: 36px 0;
    background: linear-gradient(135deg, rgba(166,124,42,0.08), rgba(166,124,42,0.02));
    position: relative;
  }
  .pull::before {
    content: '\201C'; font-family: 'Amiri', serif; font-size: 5rem;
    color: var(--gold); opacity: 0.2;
    position: absolute; top: -12px; left: 10px; line-height: 1;
  }
  .pull p { font-style: italic; font-size: clamp(1.05rem, 2.5vw, 1.22rem); color: var(--green); line-height: 1.72; margin-bottom: 8px; text-align: left; }
  .pull .attr { font-size: 0.75rem; color: var(--muted); font-style: normal; text-align: right; margin-bottom: 0; }

  /* ===== HADITH BOX ===== */
  .hadith {
    background: linear-gradient(150deg, #100e08, #0d0b06);
    border: 1px solid rgba(166,124,42,0.22);
    padding: 30px 36px; margin: 36px 0; text-align: center; position: relative;
  }
  .hadith::before { content: ''; position: absolute; inset: 5px; border: 1px solid rgba(166,124,42,0.08); pointer-events: none; }
  .hadith-ar { font-family: 'Amiri', serif; font-size: clamp(1.1rem, 2.8vw, 1.6rem); color: var(--gold-pale); direction: rtl; line-height: 2.1; margin-bottom: 18px; }
  .hadith-tr { font-style: italic; font-size: clamp(0.88rem, 2vw, 1.02rem); color: #c0a060; line-height: 1.85; margin-bottom: 10px; text-align: center; }
  .hadith-src { font-size: 0.7rem; color: #5a4430; text-align: center; margin-bottom: 0; }

  /* ===== GEO CARDS ===== */
  .geo-grid { display: flex; flex-direction: column; gap: 2px; margin: 36px 0; }
  .geo-card { display: grid; grid-template-columns: 6px 1fr; overflow: hidden; background: linear-gradient(135deg, var(--parch2), var(--parch3)); }
  .geo-stripe { background: var(--slate); }
  .geo-card:nth-child(2) .geo-stripe { background: var(--teal); }
  .geo-card:nth-child(3) .geo-stripe { background: var(--crimson); }
  .geo-card:nth-child(4) .geo-stripe { background: var(--green); }
  .geo-card:nth-child(5) .geo-stripe { background: #5a4010; }
  .geo-body { padding: 20px 24px; }
  .geo-label { font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .geo-title { font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 8px; line-height: 1.3; }
  .geo-body p { font-size: 0.93rem; line-height: 1.8; margin-bottom: 0; text-align: left; }

  /* ===== TIMELINE ===== */
  .timeline { border-left: 2px solid var(--gold); padding-left: 28px; margin: 36px 0; }
  .tl-item { position: relative; margin-bottom: 30px; }
  .tl-item:last-child { margin-bottom: 0; }
  .tl-item::before { content: ''; position: absolute; left: -35px; top: 7px; width: 13px; height: 13px; border-radius: 50%; background: var(--gold); border: 2px solid var(--parch); }
  .tl-label { font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--gold); text-transform: uppercase; margin-bottom: 6px; }
  .tl-item p { margin-bottom: 0; text-align: left; font-size: 0.95rem; line-height: 1.82; }

  /* ===== CALLOUT ===== */
  .callout { background: var(--slate); padding: 22px 28px; margin: 34px 0; border-left: 4px solid var(--gold-lt); }
  .callout-lbl { font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--gold-pale); text-transform: uppercase; margin-bottom: 10px; display: block; }
  .callout p { color: #b8c4cc; font-size: 0.94rem; line-height: 1.85; margin-bottom: 0; text-align: left; }

  /* ===== AYAT ===== */
  .ayat { background: var(--green); padding: 28px 34px; margin: 36px 0; }
  .ayat-ar { font-family: 'Amiri', serif; font-size: clamp(1.1rem, 2.8vw, 1.55rem); color: var(--gold-pale); direction: rtl; line-height: 2.1; margin-bottom: 16px; text-align: center; }
  .ayat-tr { font-style: italic; font-size: clamp(0.88rem, 2vw, 1rem); color: #b0cbb8; line-height: 1.85; margin-bottom: 8px; text-align: center; }
  .ayat-src { font-size: 0.7rem; color: #6a8a70; text-align: center; margin-bottom: 0; }

  /* ===== YASSIN ===== */
  .yassin { border: 1px solid var(--gold); padding: 28px 34px; margin: 40px 0; position: relative; background: rgba(166,124,42,0.04); }
  .yassin-lbl { position: absolute; top: -13px; left: 20px; background: var(--parch); padding: 0 10px; font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--gold); text-transform: uppercase; }
  .yassin-quote { font-size: clamp(1rem, 2.5vw, 1.15rem); font-style: italic; color: var(--green); line-height: 1.8; margin-bottom: 16px; text-align: center; }
  .yassin-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px; margin: 16px 0 0; }
  .yassin-col { background: var(--parch2); padding: 14px 16px; text-align: center; }
  .yassin-col-num { font-family: 'Cinzel', serif; font-size: 1.3rem; color: var(--gold); font-weight: 600; }
  .yassin-col-label { font-size: 0.75rem; color: var(--muted); margin-top: 4px; line-height: 1.4; }
  .yassin-col-tahun { font-size: 0.8rem; font-weight: 700; color: var(--crimson); margin-top: 2px; }

  /* ===== MUHASABAH ===== */
  .muhasabah { border: 1px solid var(--crimson); padding: 30px 34px; margin: 44px 0; position: relative; background: rgba(106,26,26,0.04); }
  .muhasabah-lbl { position: absolute; top: -13px; left: 20px; background: var(--parch); padding: 0 10px; font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--crimson); text-transform: uppercase; }
  .muhasabah p { font-style: italic; color: var(--crimson); margin-bottom: 1em; text-align: left; line-height: 1.85; }
  .muhasabah p:last-child { margin-bottom: 0; }

  /* ===== COLOFON ===== */
  .colofon { background: var(--dark2); border-top: 1px solid rgba(166,124,42,0.15); padding: 28px; text-align: center; max-width: 840px; margin: 0 auto; }
  .colofon p { font-family: 'Cinzel', serif; font-size: 0.62rem; letter-spacing: 0.22em; color: #3e3020; text-transform: uppercase; margin-bottom: 0; line-height: 2; }
  .colofon span { color: #6a5030; }

  /* ===== PENUTUP ===== */
  .penutup { background: linear-gradient(160deg, #0c0a06, #181408, #080d06); padding: 72px 28px; text-align: center; }
  .penutup-ornament { font-size: 1.3rem; letter-spacing: 0.8em; color: var(--gold); opacity: 0.5; margin-bottom: 36px; }
  .penutup-arabic { font-family: 'Amiri', serif; font-size: clamp(1.4rem, 3.5vw, 2rem); color: var(--gold-pale); direction: rtl; line-height: 1.95; max-width: 640px; margin: 0 auto 16px; }
  .penutup-tr { font-style: italic; font-size: clamp(0.88rem, 2vw, 1.02rem); color: #9a7e48; line-height: 1.8; max-width: 540px; margin: 0 auto 6px; }
  .penutup-src { font-size: 0.7rem; color: #4a3c28; margin-bottom: 36px; }
  .penutup-narasi { font-style: italic; font-size: clamp(0.92rem, 2vw, 1.05rem); color: #9a8060; line-height: 1.95; max-width: 600px; margin: 0 auto 14px; }
  .penutup-doa { font-size: 0.7rem; color: #4a3c28; font-style: italic; }
  .penutup-rule { width: 80px; height: 1px; background: linear-gradient(90deg,transparent,var(--gold),transparent); margin: 28px auto; }

  @keyframes dawn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 600px) {
    .drop-cap::first-letter { font-size: 4rem; }
    .yassin-grid { grid-template-columns: 1fr; }
    .hadith { padding: 22px 16px; }
    .geo-card { grid-template-columns: 4px 1fr; }
    .prolog { padding: 40px 20px 0; }
  }
</style>
</head>
